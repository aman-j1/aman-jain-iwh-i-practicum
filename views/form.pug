doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Add or Update Pet

        //- Form for creating/updating a custom object (pet)
        form(action="/form", method="POST")
            div
                label(for="name") Name:
                input(type="text", id="name", name="name", required=true)
            div
                label(for="bio") Bio:
                input(type="text", id="bio", name="bio", required=true)
            div
                label(for="species") Species:
                input(type="text", id="species", name="species", required=true)
            div
                button(type="submit") Submit
